<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/gba_bezel">

    <!-- Header: Move Name + Type Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/txtTooltipMoveTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Lanzallamas"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTooltipMoveType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FUEGO"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="#FFEE8130" />
    </LinearLayout>

    <!-- Stats row: Category, Power, Accuracy, PP -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp"
        android:background="#22FFFFFF"
        android:padding="8dp">

        <TextView
            android:id="@+id/txtTooltipMoveCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Especial"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/txtTooltipMovePower"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Poder: 90"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/txtTooltipMoveAccuracy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Precisión: 100%"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/txtTooltipMovePP"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PP: 15/15"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Move Description -->
    <TextView
        android:id="@+id/txtTooltipMoveDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="10% de probabilidad de quemar al objetivo."
        android:textColor="#EEFFFFFF"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp" />

</LinearLayout>
