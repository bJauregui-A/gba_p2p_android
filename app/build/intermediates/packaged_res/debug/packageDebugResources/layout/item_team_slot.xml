<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootTeamSlot"
    android:layout_width="44dp"
    android:layout_height="50dp"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_team_slot"
    android:padding="2dp"
    android:layout_marginHorizontal="2dp">

    <FrameLayout
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="center_horizontal">

        <ImageView
            android:id="@+id/imgPokeIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_pokeball" />

        <ImageView
            android:id="@+id/imgFaintCross"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_pokeball_fainted"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:background="#DDFF4757"
            android:textColor="@color/white"
            android:textSize="7sp"
            android:textStyle="bold"
            android:paddingHorizontal="2dp"
            android:visibility="gone" />
    </FrameLayout>

    <ProgressBar
        android:id="@+id/barSlotHp"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="36dp"
        android:layout_height="3dp"
        android:layout_marginTop="2dp"
        android:progress="100"
        android:progressTint="@color/gba_online_green" />

</LinearLayout>
