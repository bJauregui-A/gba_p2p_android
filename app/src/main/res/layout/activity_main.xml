<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Portrait: GBA Screen at top (3:2 ratio filling screen width) with OpenGL ES 2.0 Shaders -->
    <com.multiplayer.gbalink.ui.GbaGlSurfaceView
        android:id="@+id/gbaSurface"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="3:2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Portrait: Virtual Gamepad fills the lower half below the screen -->
    <com.multiplayer.gbalink.ui.TouchControllerView
        android:id="@+id/touchController"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/gbaSurface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- In-Game Options Menu Button (Floating overlay top right, highest Z-order) -->
    <ImageButton
        android:id="@+id/btnInGameMenu"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_ingame_menu_button"
        android:src="@drawable/ic_menu_bars"
        android:contentDescription="Opciones de juego"
        android:padding="10dp"
        android:elevation="20dp"
        app:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
