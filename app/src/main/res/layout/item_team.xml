<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_hp_box"
    android:padding="10dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txtTeamName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Gen 3 ADV OU (Standard)"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtTeamFormat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[gen3ou]"
            android:textColor="@color/gba_online_green"
            android:textSize="11sp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnExportTeam"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Exportar"
            android:textSize="10sp"
            android:backgroundTint="@color/gba_bezel"
            android:textColor="@color/white"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnDeleteTeam"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Eliminar"
            android:textSize="10sp"
            android:backgroundTint="@color/gba_button_a"
            android:textColor="@color/white" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtTeamMembers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tyranitar, Swampert, Skarmory, Blissey, Gengar, Salamence"
        android:textColor="#BBFFFFFF"
        android:textSize="11sp"
        android:layout_marginTop="4dp" />

</LinearLayout>
