<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootShowdownLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gba_bg"
    android:padding="6dp">

    <!-- Top Navigation Header -->
    <LinearLayout
        android:id="@+id/showdownHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnBackToGba"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="← GBA"
            android:textSize="11sp"
            android:backgroundTint="@color/gba_bezel"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/txtShowdownUser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="No conectado"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnShowdownLogin"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Reservar Nombre"
            android:textSize="11sp"
            android:backgroundTint="@color/gba_indigo"
            android:textColor="@color/white" />
    </LinearLayout>

    <!-- Main Navigation Tabs (Web Parity: Combate, Equipos, Chat, Espectador) -->
    <LinearLayout
        android:id="@+id/layoutShowdownTabs"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/showdownHeader">

        <Button
            android:id="@+id/btnTabLobby"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Combate"
            android:textSize="10sp"
            android:backgroundTint="@color/gba_indigo"
            android:textColor="@color/white"
            android:layout_marginEnd="2dp" />

        <Button
            android:id="@+id/btnTabTeams"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Equipos"
            android:textSize="10sp"
            android:backgroundTint="@color/gba_bezel"
            android:textColor="@color/white"
            android:layout_marginEnd="2dp" />

        <Button
            android:id="@+id/btnTabGlobalChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Chat Global"
            android:textSize="10sp"
            android:backgroundTint="@color/gba_bezel"
            android:textColor="@color/white"
            android:layout_marginEnd="2dp" />

        <Button
            android:id="@+id/btnTabSpectate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Ver Combates"
            android:textSize="10sp"
            android:backgroundTint="@color/gba_bezel"
            android:textColor="@color/white" />
    </LinearLayout>

    <!-- Incoming Challenge Banner -->
    <LinearLayout
        android:id="@+id/layoutIncomingChallenge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#DD30336B"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/layoutShowdownTabs">

        <TextView
            android:id="@+id/txtChallengeFrom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="¡Reto recibido de Entrenador!"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnAcceptChallenge"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="Aceptar"
            android:backgroundTint="@color/gba_online_green"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnRejectChallenge"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="Rechazar"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/gba_button_a"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- TAB 1: LOBBY & BATTLES (Matchmaking, Retos, Perfil) -->
    <ScrollView
        android:id="@+id/layoutLobby"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/layoutIncomingChallenge"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pokémon Showdown"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/txtLobbyStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Conectado al servidor oficial"
                android:textColor="@color/gba_online_green"
                android:textSize="12sp"
                android:layout_marginBottom="14dp" />

            <!-- Formato Selector -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Formato de Batalla:"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginBottom="2dp" />

            <Spinner
                android:id="@+id/spinnerFormat"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="#22FFFFFF"
                android:layout_marginBottom="10dp" />

            <!-- Selector de Equipo -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Equipo a Utilizar:"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginBottom="2dp" />

            <Spinner
                android:id="@+id/spinnerTeamSelect"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="#22FFFFFF"
                android:layout_marginBottom="16dp" />

            <!-- Matchmaking Button -->
            <Button
                android:id="@+id/btnSearchOpponent"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Buscar Contrincante (Ladder)"
                android:backgroundTint="@color/gba_indigo"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#33FFFFFF"
                android:layout_marginBottom="16dp" />

            <!-- Reto Directo -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Retar a un Entrenador:"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/editChallengeUser"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:hint="Nombre de usuario"
                    android:textColor="@color/white"
                    android:textColorHint="#88FFFFFF"
                    android:background="#15FFFFFF"
                    android:paddingHorizontal="10dp"
                    android:textSize="12sp"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btnChallengeDirect"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="Retar"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/gba_accent"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Buscar Perfil de Usuario -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Buscar Perfil / Ranking de Jugador:"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/editSearchUser"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:hint="Usuario a consultar"
                    android:textColor="@color/white"
                    android:textColorHint="#88FFFFFF"
                    android:background="#15FFFFFF"
                    android:paddingHorizontal="10dp"
                    android:textSize="12sp"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btnSearchUser"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="Ver Perfil"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/gba_bezel"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- TAB 2: TEAMBUILDER (Constructor de Equipos) -->
    <LinearLayout
        android:id="@+id/layoutTeambuilder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/layoutIncomingChallenge"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Constructor de Equipos"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnImportTeam"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Importar (Pokepaste)"
                android:textSize="11sp"
                android:backgroundTint="@color/gba_indigo"
                android:textColor="@color/white" />
        </LinearLayout>

        <ListView
            android:id="@+id/listTeams"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp" />
    </LinearLayout>

    <!-- TAB 3: GLOBAL CHAT (Chat Oficial de Showdown) -->
    <LinearLayout
        android:id="@+id/layoutGlobalChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/layoutIncomingChallenge"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chat Oficial de Pokémon Showdown (Lobby)"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <ListView
            android:id="@+id/listGlobalChat"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#11000000"
            android:divider="#22FFFFFF"
            android:dividerHeight="1dp"
            android:transcriptMode="alwaysScroll"
            android:stackFromBottom="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <EditText
                android:id="@+id/editLobbyMessage"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:hint="Escribe un mensaje en el chat..."
                android:textColor="@color/white"
                android:textColorHint="#88FFFFFF"
                android:background="#22FFFFFF"
                android:paddingHorizontal="10dp"
                android:textSize="12sp"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnSendLobbyChat"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="Enviar"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/gba_online_green"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- TAB 4: SPECTATE (Ver Combates en Vivo) -->
    <LinearLayout
        android:id="@+id/layoutSpectate"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/layoutIncomingChallenge"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ver Combates en Vivo (Modo Espectador)"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <EditText
                android:id="@+id/editSpectateRoom"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:hint="ID de sala (ej. battle-gen9ou-12345)"
                android:textColor="@color/white"
                android:textColorHint="#88FFFFFF"
                android:background="#22FFFFFF"
                android:paddingHorizontal="10dp"
                android:textSize="12sp"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnStartSpectate"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="Observar"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/gba_indigo"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Salas Públicas Activas:"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnRefreshPublicRooms"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Actualizar"
                android:textSize="10sp"
                android:backgroundTint="@color/gba_bezel"
                android:textColor="@color/white" />
        </LinearLayout>

        <ListView
            android:id="@+id/listPublicRooms"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="6dp" />
    </LinearLayout>

    <!-- LIVE BATTLE ARENA VIEW (16:9 Aspect Ratio & Full Controls) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutBattleArena"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/showdownHeader"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Top Battle Bar: Timer & Battle Chat Toggle -->
        <LinearLayout
            android:id="@+id/battleTopBar"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#33000000"
            android:paddingHorizontal="6dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/txtBattleTimer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Timer: Inactivo"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnToggleTimer"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="Timer"
                android:textSize="10sp"
                android:backgroundTint="@color/gba_bezel"
                android:textColor="@color/white"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnTopForfeit"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="Rendirse"
                android:textSize="10sp"
                android:backgroundTint="@color/gba_button_a"
                android:textColor="@color/white"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnBattleChat"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="Chat Combate"
                android:textSize="10sp"
                android:backgroundTint="@color/gba_indigo"
                android:textColor="@color/white" />
        </LinearLayout>

        <!-- Opponent Team Status Bar (Top: 6 Pokeballs / Revealed Pokémon) -->
        <LinearLayout
            android:id="@+id/layoutOpponentTeam"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#33000000"
            android:paddingVertical="1dp"
            app:layout_constraintTop_toBottomOf="@id/battleTopBar">

            <TextView
                android:id="@+id/txtOpponentTeamLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rival:"
                android:textColor="#CCFFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginEnd="4dp" />

            <include android:id="@+id/oppSlot1" layout="@layout/item_team_slot" />
            <include android:id="@+id/oppSlot2" layout="@layout/item_team_slot" />
            <include android:id="@+id/oppSlot3" layout="@layout/item_team_slot" />
            <include android:id="@+id/oppSlot4" layout="@layout/item_team_slot" />
            <include android:id="@+id/oppSlot5" layout="@layout/item_team_slot" />
            <include android:id="@+id/oppSlot6" layout="@layout/item_team_slot" />
        </LinearLayout>

        <!-- 16:9 BATTLEFIELD STAGE -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/battleStage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="16:9"
            app:layout_constraintTop_toBottomOf="@id/layoutOpponentTeam"
            app:layout_constraintBottom_toTopOf="@id/layoutMyTeam"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Official Stadium Background -->
            <ImageView
                android:id="@+id/imgBattleBackground"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_stadium_fallback" />

            <!-- Opponent Ground Platform -->
            <View
                android:id="@+id/platformOpponent"
                android:layout_width="140dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_battle_platform"
                android:layout_marginEnd="32dp"
                android:layout_marginTop="70dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Opponent Animated Front Sprite -->
            <ImageView
                android:id="@+id/imgOpponentSprite"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toBottomOf="@id/platformOpponent"
                app:layout_constraintStart_toStartOf="@id/platformOpponent"
                app:layout_constraintEnd_toEndOf="@id/platformOpponent"
                android:layout_marginBottom="12dp" />

            <!-- Opponent HP & Status Box (Top-Left) -->
            <LinearLayout
                android:id="@+id/layoutOpponent"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_hp_box"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/txtOpponentPokemon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rival: Pikachu"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/progressOpponentHp"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:progress="100"
                    android:progressTint="@color/gba_online_green"
                    android:layout_marginVertical="3dp" />

                <TextView
                    android:id="@+id/txtOpponentHp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textColor="@color/white"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Player Ground Platform -->
            <View
                android:id="@+id/platformMy"
                android:layout_width="160dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_battle_platform"
                android:layout_marginStart="32dp"
                android:layout_marginBottom="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Player Animated Back Sprite -->
            <ImageView
                android:id="@+id/imgMySprite"
                android:layout_width="108dp"
                android:layout_height="108dp"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toBottomOf="@id/platformMy"
                app:layout_constraintStart_toStartOf="@id/platformMy"
                app:layout_constraintEnd_toEndOf="@id/platformMy"
                android:layout_marginBottom="14dp" />

            <!-- Player HP & Status Box (Bottom-Right) -->
            <LinearLayout
                android:id="@+id/layoutMyPokemon"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_hp_box"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/txtMyPokemon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tú: Charizard"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/progressMyHp"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:progress="100"
                    android:progressTint="@color/gba_online_green"
                    android:layout_marginVertical="3dp" />

                <TextView
                    android:id="@+id/txtMyHp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100/100"
                    android:textColor="@color/white"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Floating Damage Text Container -->
            <FrameLayout
                android:id="@+id/effectsOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Player Team Status Bar (Bottom: 6 Pokémon with HP, active highlight & switch tap) -->
        <LinearLayout
            android:id="@+id/layoutMyTeam"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#33000000"
            android:paddingVertical="1dp"
            app:layout_constraintTop_toBottomOf="@id/battleStage"
            app:layout_constraintBottom_toTopOf="@id/layoutForceSwitchBanner">

            <TextView
                android:id="@+id/txtMyTeamLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Equipo:"
                android:textColor="#CCFFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginEnd="4dp" />

            <include android:id="@+id/mySlot1" layout="@layout/item_team_slot" />
            <include android:id="@+id/mySlot2" layout="@layout/item_team_slot" />
            <include android:id="@+id/mySlot3" layout="@layout/item_team_slot" />
            <include android:id="@+id/mySlot4" layout="@layout/item_team_slot" />
            <include android:id="@+id/mySlot5" layout="@layout/item_team_slot" />
            <include android:id="@+id/mySlot6" layout="@layout/item_team_slot" />
        </LinearLayout>

        <!-- Force Switch Alert Banner (Visible when active Pokemon faints) -->
        <LinearLayout
            android:id="@+id/layoutForceSwitchBanner"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#DDB33925"
            android:paddingHorizontal="8dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/layoutMyTeam"
            app:layout_constraintBottom_toTopOf="@id/txtBattleLogs">

            <TextView
                android:id="@+id/txtForceSwitchPrompt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="¡Tu Pokémon se debilitó! Toca tu equipo o pulsa Cambiar."
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnQuickSwitch"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="Elegir Relevo"
                android:textSize="10sp"
                android:backgroundTint="@color/gba_online_green"
                android:textColor="@color/white" />
        </LinearLayout>

        <!-- Battle Narration Banner -->
        <TextView
            android:id="@+id/txtBattleLogs"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:background="#33000000"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:textColor="#EEFFFFFF"
            android:textSize="11sp"
            android:singleLine="true"
            android:text="¡Comienza el combate Pokémon!"
            app:layout_constraintTop_toBottomOf="@id/layoutForceSwitchBanner"
            app:layout_constraintBottom_toTopOf="@id/checkSpecialAction" />

        <!-- Terastallize / Mega Evolution Checkbox -->
        <CheckBox
            android:id="@+id/checkSpecialAction"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="Teracristalizar / Mega Evolución"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/layoutMoves" />

        <!-- 4 Moves Grid with Elemental Colors -->
        <GridLayout
            android:id="@+id/layoutMoves"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/layoutBattleControls"
            app:layout_constraintBottom_toBottomOf="parent">

            <Button
                android:id="@+id/btnMove1"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:text="Ataque 1"
                android:textSize="11sp"
                android:backgroundTint="@color/gba_indigo"
                android:textColor="@color/white"
                android:layout_margin="2dp" />

            <Button
                android:id="@+id/btnMove2"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:text="Ataque 2"
                android:textSize="11sp"
                android:backgroundTint="@color/gba_indigo"
                android:textColor="@color/white"
                android:layout_margin="2dp" />

            <Button
                android:id="@+id/btnMove3"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:text="Ataque 3"
                android:textSize="11sp"
                android:backgroundTint="@color/gba_indigo"
                android:textColor="@color/white"
                android:layout_margin="2dp" />

            <Button
                android:id="@+id/btnMove4"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:text="Ataque 4"
                android:textSize="11sp"
                android:backgroundTint="@color/gba_indigo"
                android:textColor="@color/white"
                android:layout_margin="2dp" />
        </GridLayout>

        <!-- Battle Controls: Switch & Forfeit -->
        <LinearLayout
            android:id="@+id/layoutBattleControls"
            android:layout_width="110dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="4dp"
            app:layout_constraintTop_toTopOf="@id/layoutMoves"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <Button
                android:id="@+id/btnSwitchPokemon"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="Cambiar"
                android:backgroundTint="@color/gba_accent"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:layout_marginBottom="2dp" />

            <Button
                android:id="@+id/btnForfeit"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="Rendirse"
                android:backgroundTint="@color/gba_button_a"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Spectator Banner (Overlays controls when spectating) -->
        <LinearLayout
            android:id="@+id/layoutSpectatorControls"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#DD2C3E50"
            android:paddingHorizontal="12dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Modo Espectador - Observando Combate"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnLeaveSpectate"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Salir"
                android:textSize="11sp"
                android:backgroundTint="@color/gba_button_a"
                android:textColor="@color/white" />
        </LinearLayout>


        <!-- Showdown's own battle engine (scene, log, move/switch buttons). Covers the native view when loaded. -->
        <FrameLayout
            android:id="@+id/battleWebContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#FF1B1E2B"
            android:elevation="12dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/battleTopBar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
